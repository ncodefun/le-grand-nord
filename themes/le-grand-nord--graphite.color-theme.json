{
    "$schema": "vscode://schemas/color-theme",
    "colors": {
        "activityBar.activeBorder": "#707070",
        "activityBar.background": "#292929",
        "activityBar.foreground": "#aeaeae",
        "activityBar.inactiveForeground": "#8c8c8caa",
        "activityBarBadge.background": "#9cdc83",
        "activityBarBadge.foreground": "#000",
        "badge.background": "#9cdc83",
        "badge.foreground": "#000",
        "button.background": "#a9a9a9",
        "diffEditor.insertedLineBackground": "#a8ff3723",
        "diffEditor.insertedTextBackground": "#a8ff3730",
        "dropdown.background": "#2a3232",
        "dropdown.foreground": "#cbfff9",
        "dropdown.listBackground": "#2a3232",
        // "editor.background": "#2c2a29",
        "editor.background": "#282726",
        "editor.findMatchBackground": "#536a37", // current match
        "editor.findMatchHighlightBackground": "#39452acc", // others
        "editor.foldBackground": "#ffffff03",
        "editor.foreground": "#eeeeee",
        "editor.inactiveSelectionBackground": "#6867417e",
        "editor.lineHighlightBackground": "#e3ff8610",
        "editor.rangeHighlightBackground": "#86fff114",
        "editor.selectionBackground": "#a3a11630",
        "editor.selectionHighlightBackground": "#ffffff13",
        "editor.wordHighlightBackground": "#ceff8022",
        "editor.wordHighlightStrongBackground": "#ceff8044",
        "editor.wordHighlightTextBackground": "#ceff8022",
        "editorBracketMatch.background": "#4ab33c73",
        "editorBracketMatch.border": "#88888800",
        "editorGroup.border": "#3c4344",
        "editorGroupHeader.border": "#363636",
        "editorGroupHeader.tabsBackground": "#292929",
        "editorGutter.background": "#292929",
        "editorHoverWidget.border": "#a8a581",
        "editorIndentGuide.activeBackground1": "#fcffcb88",
        "editorIndentGuide.background1": "#404040",
        "editorLineNumber.activeForeground": "#696a64",
        "editorLineNumber.foreground": "#656a5b60",
        "editorStickyScroll.background": "#31322b",
        "editorStickyScroll.border": "#2c3132",
        "editorStickyScroll.shadow": "#00000017",
        "editorStickyScrollHover.background": "#323529",
        "editorSuggestWidget.border": "#a8a8a8",
        "editorSuggestWidget.selectedBackground": "#81a8a122",
        "editorWhitespace.foreground": "#262626",
        "editorWidget.background": "#202020",
        "editorWidget.border": "#383631",
        "editorWidget.foreground": "#8a8a8a",
        "focusBorder": "#fdffbc4e",
        "gitDecoration.addedResourceForeground": "#81b88baa",
        "gitDecoration.conflictingResourceForeground": "#e4676b",
        "gitDecoration.deletedResourceForeground": "#c74e39aa",
        "gitDecoration.ignoredResourceForeground": "#92918e99",
        "gitDecoration.modifiedResourceForeground": "#e2c08daa",
        "gitDecoration.renamedResourceForeground": "#73c991aa",
        "gitDecoration.stageDeletedResourceForeground": "#c74e39aa",
        "gitDecoration.stageModifiedResourceForeground": "#e2c08daa",
        "gitDecoration.submoduleResourceForeground": "#8db9e2",
        "gitDecoration.untrackedResourceForeground": "#73c991",
        "icon.foreground": "#888888",
        "input.background": "#111111",
        "input.foreground": "#fffdf7",
        "input.placeholderForeground": "#7a7a7a",
        "inputOption.activeBorder": "#a9a990",
        "list.activeSelectionBackground": "#ffffff44",
        "list.dropBackground": "#525252",
        "list.focusBackground": "#222222",
        "list.focusForeground": "#ffffff",
        "list.hoverBackground": "#222222",
        "list.hoverForeground": "#f4f1e8",
        "list.inactiveFocusBackground": "#81a8a106",
        "list.inactiveSelectionBackground": "#ffffff11",
        "listFilterWidget.background": "#72ecd677",
        "listFilterWidget.noMatchesOutline": "#ec72c7",
        "listFilterWidget.outline": "#72ecd6",
        "menu.background": "#282625",
        "menu.foreground": "#dfd8cd",
        // "menu.selectionBorder": "#...",
        // "menu.border": "#..."
        "minimap.background": "#24282a",
        "panel.background": "#292929",
        "panel.border": "#81a8a160",
        "scrollbar.shadow": "#00000030",
        "scrollbarSlider.activeBackground": "#79745e88",
        "scrollbarSlider.background": "#79755e33",
        "scrollbarSlider.hoverBackground": "#79755e66",
        // "diffEditor.insertedTextBackground": "#9bb95533", // default
        //"diffEditor.removedLineBackground": "#ff000033",
        //"diffEditor.removedTextBackground": "#ff000033",P
        "sideBar.background": "#292929",
        "sideBar.border": "#363636",
        "sideBar.foreground": "#92918e",
        
        "sideBarSectionHeader.background": "#292929",
        "sideBarSectionHeader.foreground": "#7b7876CC",
        "sideBarTitle.background": "#292929",
        "sideBarTitle.foreground": "#cbfff900",
        "statusBar.background": "#282625",
        // "statusBar.noFolderBackground": "#222627",
        "statusBar.debuggingBackground": "#2c5131",
        "statusBar.foreground": "#7b7876cc",
        "statusBar.noFolderBackground": "#272525",
        "tab.activeBackground": "#484733",
        "tab.activeForeground": "#ffffffbb",
        "tab.border": "#c1c77c22",
        "tab.inactiveBackground": "#252525",
        "tab.inactiveForeground": "#ffffff55",
        "tab.unfocusedHoverBackground": "#38372e",
        "terminal.ansiCyan": "#8dfef0",
        "terminal.ansiGreen": "#b0ff91",
        "terminal.ansiMagenta": "#ff5fb7",
        "terminal.ansiYellow": "#e7ff91",
        "terminal.foreground": "#ddd",
        "textLink.activeForeground": "#d3ccb3",
        // "textLink.foreground": "#A890AD",
        // "textLink.activeForeground": "#A890AD",
        "textLink.foreground": "#ada690",
        "titleBar.activeBackground": "#292929",
        "titleBar.activeForeground": "#ffffff50",
        "widget.shadow": "#00000040"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class.defaultLibrary": "#aadeb3",
        "parameter": {
            "foreground": "#ccded9",
            "italic": true
        },
        "parameter.declaration": {
            "foreground": "#ccded9",
            "italic": true
        },
        "property": "#B3E0D1",
        "variable.defaultLibrary": "#6DB1A9"
    },
    "tokenColors": [
        {
            "name": "py params",
            "scope": [
                "meta.function.parameters.python",
                "meta.function-call.arguments.python",
                "variable.parameter",
                "string.regexp constant.other.character-class.set.regexp"
            ],
            "settings": {
                "foreground": "#ccded9"
            }
        },
        {
            "name": "LIGHT – Default color",
            "settings": {
                "foreground": "#eee"
            }
        },
        {
            "name": "COTTON – Base color",
            "scope": [
                "variable",
                "meta.template.expression.js",
                "string.js.taggedTemplate meta.embedded.block.html",
                "string.regexp.js",
                "source.python meta.fstring.python"
            ],
            "settings": {
                "foreground": "#dddddd"
            }
        },
        {
            "name": "GHOSTLY – Comment tags",
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#ffffff22"
            }
        },
        {
            "name": "GHOST – Comments",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#ffffff33"
            }
        },
        {
            "name": "CLOUD – Storage", /* (let, const, function, class); CSS pseudo */
            "scope": [
                "storage",
                "entity.other.attribute-name.pseudo-class.css",
                "punctuation.definition.character-class.regexp" // [a-zA-Z]
            ],
            "settings": {
                "foreground": "#6e8e89"
            }
        },
        {
            "name": "MIST – Punctuation", /* (CLOUD faded) */
            "scope": [
                "meta.brace",
                "punctuation",
                "entity.other.attribute-name.id.css punctuation.definition.entity.css",
                "entity.other.attribute-name.class.css punctuation.definition.entity.css",
                "constant.character.format.placeholder.other.python"
            ],
            "settings": {
                "foreground": "#6e8e89" /* Higher contrast */
            }
        },
        {
            "name": "MIST – Angled brackets (</>)",
            "scope": [
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#6e8e89cc"
            }
        },
        {
            "name": "RAIN – Elements", /* punct. accessor + CSS ids and classes" */
            "scope": [
                "entity.name.tag",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "punctuation.accessor",
                "punctuation.separator.key-value.js",
                "keyword.operator.type.annotation.ts",
                "source.css",
                "string.regexp.js constant"
            ],
            "settings": {
                "foreground": "#7da9a5"
            }
        },
        {
            "name": "SEA – Primitives",
            "scope": [
                "support.variable.dom",
                "support.constant",
                "variable.language",
                "support.class",
                "support.type.primitive.ts"
            ],
            "settings": {
                "foreground": "#6db1a9"
            }
        },
        {
            "name": "DEEPSKY – Operators, Math signs",
            "scope": [
                "keyword.operator",
                "keyword.operator.quantifier.regexp" // {2,}
            ],
            "settings": {
                "foreground": "#82cec5"
            }
        },
        {
            "name": "SKY – JS functions",
            "scope": [
                "entity.name.function",
                "entity.name.function.tagged-template",
                "meta.function-call",
                "source.css support.function",
                "string.js.taggedTemplate punctuation.definition.string.template" // html``
            ],
            "settings": {
                "foreground": "#95dcd4"
            }
        },
        {
            "name": "ICE – Props, obj. keys, Func. params, Attr. names",
            "scope": [
                "meta.object-literal.key",
                "meta.object-literal.key string",
                "entity.other.attribute-name",
                "support.type.property-name",
                "meta.function-call.arguments.pythonz",
                "support.variable.property",
                "meta.attribute.python",
                "variable.other.object.property",
                "variable.other.property" // this._prop
            ],
            "settings": {
                "foreground": "#b3e0d1"
            }
        },
        {
            "name": "FOREST – JS 'new'; CSS units",
            "scope": [
                "keyword.operator.new",
                "keyword.other.unit", // css units
                "entity.other.attribute-name.pseudo-element.css punctuation.definition.entity.css" // ::
            ],
            "settings": {
                "foreground": "#83aa8a"
            }
        },
        {
            "name": "MINT – JS class, @jsdocs",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": {
                "foreground": "#aadeb3"
            }
        },
        {
            "name": "SPROUT – All values (string, constant)",
            "scope": [
                "string",
                "constant",
                "source.css support.constant",
                "meta.property-value.css", // grid-area: footer;
                "string.js.taggedTemplate source.css" // override source.css
            ],
            "settings": {
                "foreground": "#90D794"
            }
        },
        {
            "name": "HALO | ITALIC – JS Str template; CSS @media",
            "scope": [
                "string.template",
                "punctuation.definition.keyword",
                "source.css keyword.control",
                "entity.other.keyframe-offset.percentage.css"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#c6eab6"
            }
        },
        {
            "name": "HALO ~muted | ITALIC – RegExp; CSS vars",
            "scope": [
                "variable.css",
                "variable.argument.css",
                "variable.scss",
                "string.regexp",
                "string.regexp.js punctuation",
                "string.regexp.js keyword.other.js",
                "keyword.control.anchor.regexp",
                "constant.other.character-class.range.regexp"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#c3eab6ee"
            }
        },
        {
            "name": "HALO faded – JS string template -> faded quotes",
            "scope": [
                "string.template.js punctuation.definition.string.template"
            ],
            "settings": {
                "fontStyle": "",
                "foreground": "#c6eab6AA"
            }
        },
        {
            "name": "STONE – JS control flow",
            "scope": [
                "keyword.control",
                "entity.name.label",
                "storage.modifier.async.js",
                "keyword.generator.asterisk.js",
                "string.regexp.js punctuation.definition.group" // (?:…)
            ],
            "settings": {
                "foreground": "#7d8281"
            }
        },
        {
            "name": "PLUM – CSS !important",
            "scope": [
                "keyword.other.important.css"
            ],
            "settings": {
                "foreground": "#a290a5"
            }
        },
        {
            "name": "ROSE – JS debugger, delete, void, regex negation (^)",
            "scope": [
                "keyword.other.debugger",
                "keyword.operator.negation",
                "keyword.operator.expression.delete",
                "keyword.operator.expression.void.js"
            ],
            "settings": {
                "foreground": "#ceb0d3"
            }
        },
        {
            "name": "ITALIC – Strings, string templates, func. parameter, :pseudo-class",
            "scope": [
                "string",
                // "string.template",
                "variable.parameter",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "NOT ITALIC – TAGGED string templates (lit-html)",
            "scope": [
                "string.template",
                "string.js.taggedTemplate",
                "string.js.taggedTemplate string"
            ],
            "settings": {
                "fontStyle": ""
            }
        }
    ],
    "type": "dark"
}